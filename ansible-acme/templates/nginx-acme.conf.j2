# HTTP public -> HTTPS public.
server {
    listen {{ web_public_ip }}:80;
    server_name {{ web_server_name }};
    return 301 https://{{ web_server_name }}$request_uri;
}

# Le poste admin isole utilise l'IP admin directement.
server {
    listen {{ web_admin_ip }}:80;
    server_name {{ web_admin_ip }};
    return 301 https://{{ web_admin_ip }}$request_uri;
}

server {
    listen {{ web_public_ip }}:443 ssl;
    listen {{ web_admin_ip }}:443 ssl;
    server_name {{ web_server_name }} {{ hostname_fqdn }} {{ web_admin_ip }};
    root {{ web_root }};
    index index.php index.html;

    ssl_certificate /etc/pki/tls/certs/acme-web.crt;
    ssl_certificate_key /etc/pki/tls/private/acme-web.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    add_header X-Content-Type-Options nosniff always;

    location = /admin {
        satisfy all;
        allow {{ admin_client_ip }};
        deny all;
        auth_basic "ACME Administration";
        auth_basic_user_file /etc/nginx/secrets/admin.htpasswd;
        try_files /admin/index.html =404;
    }

    location ^~ /admin/ {
        satisfy all;
        allow {{ admin_client_ip }};
        deny all;
        auth_basic "ACME Administration";
        auth_basic_user_file /etc/nginx/secrets/admin.htpasswd;
        index index.html;
        try_files $uri $uri/ =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Seul le script public de cette application est execute.
    location = /index.php {
        include /etc/nginx/fastcgi_params;
        fastcgi_param SCRIPT_FILENAME {{ web_root }}/index.php;
        fastcgi_pass unix:/run/php-fpm/acme.sock;
    }

    location ~ \\.php$ {
        return 404;
    }

    location ~ /\\. {
        deny all;
    }
}

options {
    directory "/var/named";
    listen-on port 53 { 127.0.0.1; {{ infra_public_ip }}; {{ infra_admin_ip }}; };
    listen-on-v6 { none; };
    allow-query { localhost; {{ public_network }}; {{ admin_network }}; };
    // Autorite ACME et resolution externe pour les depots/NTP des clients.
    recursion yes;
    allow-recursion { localhost; {{ public_network }}; {{ admin_network }}; };
    allow-query-cache { localhost; {{ public_network }}; {{ admin_network }}; };
    dnssec-validation auto;
    allow-transfer { none; };
    version "ACME DNS";
    pid-file "/run/named/named.pid";
};

zone "{{ dns_domain }}" IN {
    type master;
    file "{{ forward_zone_file }}";
    allow-update { none; };
};

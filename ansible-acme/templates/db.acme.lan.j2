$TTL 3600
@ IN SOA {{ dns_ns }}. {{ dns_admin_email }}.{{ dns_domain }}. (
    {{ dns_serial }} ; serial
    3600             ; refresh
    1800             ; retry
    604800           ; expire
    3600             ; minimum
)
@ IN NS {{ dns_ns }}.
{% for record in dns_records %}
{{ record.name }} IN {{ record.type }} {{ record.value }}
{% endfor %}

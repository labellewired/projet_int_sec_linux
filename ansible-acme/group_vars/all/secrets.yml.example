---
# MODELE UNIQUEMENT : ce fichier .example n'est pas charge par Ansible.
# Copier en secrets.yml, remplir puis chiffrer avec ansible-vault encrypt.
# Les hachages sont generes UNE fois avec : openssl passwd -6
vault_linux_password_hashes:
  alabelle: "REMPLACER_PAR_HACHAGE_SHA512_CRYPT_ALABELLE"
  zlizotte: "REMPLACER_PAR_HACHAGE_SHA512_CRYPT_ZLIZOTTE"

vault_database_password: "REMPLACER_PAR_MOT_DE_PASSE_BASE_DE_DONNEES"
vault_web_admin_password_hash: "REMPLACER_PAR_HACHAGE_SHA512_CRYPT_ADMIN_WEB"

# Deux graines TOTP aleatoires distinctes, en base32, au moins 32 caracteres.
# Generer une graine avec la commande Python du README.
# Enregistrer chaque graine dans l'application d'authentification du titulaire.
vault_totp_secrets:
  alabelle: "REMPLACER_PAR_GRAINE_BASE32_ALABELLE"
  zlizotte: "REMPLACER_PAR_GRAINE_BASE32_ZLIZOTTE"

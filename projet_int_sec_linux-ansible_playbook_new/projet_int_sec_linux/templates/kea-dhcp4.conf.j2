{
  "Dhcp4": {

    "interfaces-config": {
      "interfaces": [ "*" ]
    },

    "lease-database": {
      "type": "memfile",
      "persist": true,
      "name": "/var/lib/kea/kea-leases4.csv"
    },

    "renew-timer": 432000,
    "rebind-timer": 691200,

    "valid-lifetime": {{ dhcp_default_lease_time }},

    "subnet4": [
      {
        "id": 1,
        "subnet": "{{ dhcp_network }}/{{ dhcp_subnet }}",

        "pools": [
          {
            "pool": "{{ dhcp_range_start }} - {{ dhcp_range_end }}"
          }
        ],

        "option-data": [
          {
            "name": "routers",
            "data": "{{ dhcp_gateway }}"
          },
          {
            "name": "domain-name-servers",
            "data": "{{ dns_server_ip }}"
          },
          {
            "name": "domain-name",
            "data": "{{ dns_domain }}"
          }
        ],

        "reservations": [
          {
            "hw-address": "{{ windows_client_mac }}",
            "ip-address": "{{ windows_client_ip }}"
          }
        ]
      }
    ]
  }
}
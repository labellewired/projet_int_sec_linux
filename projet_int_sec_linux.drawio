        <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#36393d;strokeWidth=1.5;dashed=1;dashPattern=6 4;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=13;fontStyle=1;" value="&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Tahoma&quot;&gt;firewalld: Ce que chaque zone laisse passer&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(107, 114, 128), rgb(255, 255, 255)); font-size: 14px;&quot; face=&quot;Tahoma&quot;&gt;•&amp;nbsp;zone public : ssh vers le bastion, https vers web, dns vers infra&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(107, 114, 128), rgb(255, 255, 255)); font-size: 14px;&quot; face=&quot;Tahoma&quot;&gt;•&amp;nbsp;zone public : 22/tcp fermé sur web et sur infra&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(107, 114, 128), rgb(255, 255, 255)); font-size: 14px;&quot; face=&quot;Tahoma&quot;&gt;•&amp;nbsp;zone admin : ssh, syslog et ntp, restreints par source&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(107, 114, 128), rgb(255, 255, 255)); font-size: 14px;&quot; face=&quot;Tahoma&quot;&gt;•&amp;nbsp;zone par défaut : drop sur les trois serveurs&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(107, 114, 128), rgb(255, 255, 255)); font-size: 14px;&quot; face=&quot;Tahoma&quot;&gt;•&amp;nbsp;3306 ouvert dans aucune zone, MariaDB sur 127.0.0.1&lt;/font&gt;&lt;/div&gt;" vertex="1">
